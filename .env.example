SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
CRM_ADMIN_PASSWORD=replace-with-a-long-unique-password
CRM_SESSION_SECRET=replace-with-at-least-32-random-characters

# Keep false until the registered telephony provider, caller identity,
# consent workflow and suppression checks are reviewed for production.
AI_CALLING_ENABLED=false
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
EXOTEL_API_KEY=replace-with-exotel-api-key
EXOTEL_API_TOKEN=replace-with-exotel-api-token
EXOTEL_ACCOUNT_SID=replace-with-exotel-account-sid
EXOTEL_CALLER_ID=replace-with-registered-caller-id
